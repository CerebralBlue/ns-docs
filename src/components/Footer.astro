---
// Override: keep Starlight's default footer (pagination, last-updated,
// edit link) and add a branded NeuralSeek site footer beneath it.
//
// Splash pages (the landing page) skip the default footer: pagination,
// "Last updated" and the edit link are meaningless on a hero page, and the
// theme puts a border-top on the bare `footer` selector, so rendering both
// footers stacks two hairlines a few rem apart.
import Default from '@astrojs/starlight/components/Footer.astro';
import ChatWidget from './ChatWidget.astro';
// Mounted here for the same reason as ChatWidget: this footer renders on
// every route, and the viewer needs exactly one instance per page. It binds
// itself to `.sl-markdown-content` by delegation, so a splash page (no
// markdown content) simply finds nothing and does nothing.
import ImageZoom from './ImageZoom.astro';

// Optional-chained: a route rendered without a starlightRoute in locals (the
// 404 page is the realistic case) would otherwise throw at render time rather
// than just falling back to the non-splash layout.
const isSplash = Astro.locals.starlightRoute?.entry?.data?.template === 'splash';

// Keep the notice current without an annual edit.
const year = new Date().getFullYear();
---

{!isSplash && <Default />}

<ChatWidget />

<ImageZoom />

<footer class="ns-footer">
	<div class="ns-footer-inner">
		<p class="ns-copyright">© {year} NeuralSeek. All rights reserved.</p>
		<nav class="ns-footer-links">
			<a href="https://neuralseek.com">NeuralSeek</a>
			<a href="https://github.com/CerebralBlue/ns-docs">GitHub</a>
		</nav>
	</div>
</footer>

<style>
	.ns-footer {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.ns-footer-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
		justify-content: space-between;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.ns-copyright {
		margin: 0;
	}
	.ns-footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.ns-footer-links a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.ns-footer-links a:hover {
		color: var(--sl-color-text-accent);
	}
</style>
