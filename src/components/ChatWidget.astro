---
// NeuralSeek Assistant chat widget: a floating launcher button that toggles
// a chat panel open/closed, with a message list + input. Questions are
// answered by a direct client-side call to the `neuralseek-documentation-website`
// instance's /seek endpoint, authenticated with an embedCode (not the admin API
// key — embedCodes are scoped to only the seek/mAIstro endpoints, so they're
// meant to ship in public frontend code, unlike the admin key).
//
// Icons come from Starlight's built-in set so they inherit currentColor and
// stay crisp at any DPR — no image assets involved. The chat bubble is a
// local inline path (Starlight's set has no chat icon) and follows the same
// rules. The panel logo is the actual N-mark PNG, same asset SocialIcons.astro
// uses for the footer brand link.
import { Icon } from '@astrojs/starlight/components';
import nsIcon from '../assets/neuraldocs-icon.png';
---

<div class="ns-chat" data-ns-chat>
	<!-- Launcher: hides while the panel is open, and the panel takes over this
	     exact spot. Icon-only, so the accessible name lives on aria-label and
	     the sighted affordance is the hover/focus tooltip (::after). -->
	<button
		type="button"
		class="ns-chat__launcher"
		data-ns-toggle
		aria-expanded="false"
		aria-controls="ns-chat-panel"
		aria-label="NeuralSeek Assistant"
	>
		<svg
			class="ns-chat__icon"
			viewBox="0 0 24 24"
			fill="currentColor"
			aria-hidden="true"
			focusable="false"
		>
			<path
				d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
			></path>
		</svg>
	</button>

	<!-- Panel -->
	<div
		class="ns-chat__modal"
		id="ns-chat-panel"
		data-ns-modal
		hidden
		role="dialog"
		aria-label="Ask NeuralSeek"
	>
		<header class="ns-chat__header">
			<div class="ns-chat__title">
				<img src={nsIcon.src} alt="" class="ns-chat__logo" />
				Ask NeuralSeek
			</div>
			<div class="ns-chat__header-actions">
				<button
					type="button"
					class="ns-chat__restart"
					data-ns-restart
					aria-label="Restart session"
					title="Restart session"
				>
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
						<path
							d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
						></path>
					</svg>
				</button>
				<button type="button" class="ns-chat__close" data-ns-close aria-label="Close chat">
					<Icon name="close" size="1.125rem" />
				</button>
			</div>
		</header>

		<div class="ns-chat__log" data-ns-log>
			<div class="ns-chat__msg ns-chat__msg--bot">
				Hi! Ask me anything about the documentation.
			</div>
		</div>

		<form class="ns-chat__form" data-ns-form>
			<input
				type="text"
				class="ns-chat__input"
				data-ns-input
				placeholder="Ask a question…"
				autocomplete="off"
				aria-label="Your question"
			/>
			<button type="submit" class="ns-chat__send" aria-label="Send">
				<Icon name="right-arrow" size="1.125rem" />
			</button>
		</form>
	</div>
</div>

<style>
	.ns-chat {
		--ns-chat-w: 380px;
		--ns-chat-h: 560px;
		--ns-chat-launcher-size: 3.5rem;
		--ns-chat-inset: 1.5rem;

		/* Widget-specific brand palette — distinct from the site's Trust Blue
		   accent, per the Chat Widget brand spec. */
		--ns-chat-primary: #3d91f0;
		--ns-chat-secondary: #9d2ff9;
		--ns-chat-accent: #000000;
	}

	/* Launcher: round, icon-only. Shares the same corner inset as the panel,
	   so the panel appears exactly where this button was. */
	.ns-chat__launcher {
		position: fixed;
		right: var(--ns-chat-inset);
		bottom: var(--ns-chat-inset);
		z-index: 100;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--ns-chat-launcher-size);
		height: var(--ns-chat-launcher-size);
		padding: 0;
		border: none;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--ns-chat-primary), var(--ns-chat-secondary));
		color: var(--ns-chat-accent);
		cursor: pointer;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.ns-chat__launcher:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 28px rgba(157, 47, 249, 0.35);
	}
	.ns-chat__launcher:focus-visible {
		outline: 2px solid var(--sl-color-white);
		outline-offset: 3px;
	}
	/* Open state: the panel occupies this corner, so the launcher steps aside.
	   Focus is moved into the panel first — see setOpen() in the script. */
	.ns-chat[data-open] .ns-chat__launcher {
		display: none;
	}

	.ns-chat__icon {
		width: 1.5rem;
		height: 1.5rem;
	}

	/* Tooltip — the icon-only launcher's visible affordance. aria-label carries
	   the same wording for screen readers, so this stays decorative. */
	.ns-chat__launcher::after {
		content: 'NeuralSeek Assistant';
		position: absolute;
		right: calc(100% + 0.65rem);
		top: 50%;
		translate: 0 -50%;
		padding: 0.35rem 0.6rem;
		border-radius: 6px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		border: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}
	.ns-chat__launcher:hover::after,
	.ns-chat__launcher:focus-visible::after {
		opacity: 1;
	}

	/* Panel: pinned to the same corner the launcher occupies. */
	.ns-chat__modal {
		position: fixed;
		right: var(--ns-chat-inset);
		bottom: var(--ns-chat-inset);
		z-index: 101;
		display: flex;
		flex-direction: column;
		width: min(var(--ns-chat-w), calc(100vw - 2rem));
		height: min(var(--ns-chat-h), calc(100vh - var(--ns-chat-inset) * 2));
		background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 14px;
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
		overflow: hidden;
		transform-origin: bottom right;
		animation: ns-chat-in 0.18s ease;
	}

	/* `display: flex` above would otherwise beat the UA's [hidden] rule (author
	   styles win at equal specificity), leaving the panel permanently open. */
	.ns-chat__modal[hidden] {
		display: none;
	}
	/* Grows out of the launcher's corner rather than sliding in from nowhere. */
	@keyframes ns-chat-in {
		from { opacity: 0; scale: 0.9; }
		to   { opacity: 1; scale: 1; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ns-chat__modal {
			animation: none;
		}
		.ns-chat__launcher {
			transition: none;
		}
		.ns-chat__launcher:hover {
			transform: none;
		}
	}

	.ns-chat__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.9rem 1rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-bg-nav);
	}
	.ns-chat__title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}
	.ns-chat__logo {
		width: 20px;
		height: 20px;
		border-radius: 5px;
	}
	.ns-chat__header-actions {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}
	.ns-chat__restart svg {
		width: 1.05rem;
		height: 1.05rem;
	}
	.ns-chat__restart,
	.ns-chat__close {
		display: inline-flex;
		padding: 0.25rem;
		border: none;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		border-radius: 6px;
	}
	.ns-chat__restart:hover,
	.ns-chat__close:hover {
		color: var(--sl-color-white);
		background: color-mix(in srgb, var(--ns-chat-secondary) 35%, var(--sl-color-gray-6));
	}

	/* Message log */
	.ns-chat__log {
		flex: 1;
		overflow-y: auto;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.ns-chat__msg {
		max-width: 85%;
		padding: 0.6rem 0.8rem;
		border-radius: 12px;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		white-space: pre-wrap;
		word-wrap: break-word;
	}
	.ns-chat__msg--bot {
		align-self: flex-start;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		border-bottom-left-radius: 4px;
	}
	.ns-chat__msg--user {
		align-self: flex-end;
		background: var(--ns-chat-primary);
		color: var(--ns-chat-accent);
		border-bottom-right-radius: 4px;
	}
	.ns-chat__msg--typing {
		color: var(--sl-color-gray-3);
		font-style: italic;
	}

	/* Input */
	.ns-chat__form {
		display: flex;
		gap: 0.5rem;
		padding: 0.75rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.ns-chat__input {
		flex: 1;
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 8px;
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
	}
	.ns-chat__input:focus {
		outline: none;
		border-color: var(--ns-chat-primary);
	}
	.ns-chat__send {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		border: none;
		border-radius: 8px;
		background: var(--ns-chat-primary);
		color: var(--ns-chat-accent);
		cursor: pointer;
		transition: background 0.15s ease;
	}
	.ns-chat__send:hover {
		background: var(--ns-chat-secondary);
	}

	@media (max-width: 30rem) {
		.ns-chat {
			--ns-chat-inset: 1rem;
		}
	}
</style>

<script>
	const STORAGE_KEY = 'ns-chat-v1';
	const SESSION_KEY = 'ns-session-id';
	const USER_KEY = 'ns-user-id';

	const SEEK_URL = 'https://stagingapi.neuralseek.com/v1/neuralseek-documentation-website/seek';
	const EMBED_CODE = '2041675160';

	function uid() {
		return crypto.randomUUID
			? crypto.randomUUID()
			: `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
	}

	function initChat() {
		const root = document.querySelector('[data-ns-chat]');
		if (!root || root.hasAttribute('data-ns-init')) return;
		root.setAttribute('data-ns-init', '');

		const modal = root.querySelector('[data-ns-modal]') as HTMLElement;
		const log = root.querySelector('[data-ns-log]') as HTMLElement;
		const form = root.querySelector('[data-ns-form]') as HTMLFormElement;
		const input = root.querySelector('[data-ns-input]') as HTMLInputElement;
		const toggleBtn = root.querySelector('[data-ns-toggle]') as HTMLButtonElement;

		// userId identifies this browser and survives a restart; sessionId
		// identifies the current conversation and is reset by it. Neither is
		// sent anywhere yet — both exist for the NeuralSeek `/seek` proxy, which
		// needs a session id to keep conversational context.
		let userId = localStorage.getItem(USER_KEY);
		if (!userId) {
			userId = uid();
			localStorage.setItem(USER_KEY, userId);
		}
		let sessionId = localStorage.getItem(SESSION_KEY);
		if (!sessionId) {
			sessionId = uid();
			localStorage.setItem(SESSION_KEY, sessionId);
		}

		let messages: { who: 'user' | 'bot'; text: string }[] = [];

		// Astro scopes this component's <style> block by appending a build-hashed
		// class (astro-xxxxxxxx) to every element in the static template; that's
		// how these rules avoid the theme's cascade layers. Elements created here
		// at runtime never get that class from the compiler, so scoped styles
		// silently skip them unless we copy it over ourselves.
		const scopeClass = Array.from(log.classList).find((c) => c.startsWith('astro-'));

		function renderMessage(text: string, who: 'user' | 'bot', extraClass = '') {
			const el = document.createElement('div');
			el.className = `ns-chat__msg ns-chat__msg--${who} ${extraClass} ${scopeClass ?? ''}`.trim();
			el.textContent = text;
			log.appendChild(el);
			log.scrollTop = log.scrollHeight;
			return el;
		}

		function addMessage(text: string, who: 'user' | 'bot') {
			const el = renderMessage(text, who);
			messages.push({ who, text });
			localStorage.setItem(STORAGE_KEY, JSON.stringify(messages));
			return el;
		}

		// Hydrate from a previous visit. The greeting hardcoded in the markup
		// only applies to a brand-new session — swap it for real history once
		// there is any.
		const saved = localStorage.getItem(STORAGE_KEY);
		if (saved) {
			try {
				const parsed = JSON.parse(saved);
				if (Array.isArray(parsed) && parsed.length) {
					log.innerHTML = '';
					for (const m of parsed) renderMessage(m.text, m.who);
					messages = parsed;
				}
			} catch {
				// Corrupt data — ignore and keep the default greeting.
			}
		}

		// Wipes history and starts a fresh session: new sessionId, empty log,
		// back to the default greeting. userId is untouched.
		function resetChat() {
			localStorage.removeItem(STORAGE_KEY);
			messages = [];
			sessionId = uid();
			localStorage.setItem(SESSION_KEY, sessionId);
			log.innerHTML = '';
			renderMessage('Hi! Ask me anything about the documentation.', 'bot');
		}

		const isOpen = () => root.hasAttribute('data-open');

		// restoreFocus: only when the user deliberately closed it (button/Esc).
		// Clicking away must not yank focus back to the launcher.
		//
		// Order matters here. Opening hides the launcher via [data-open] while it
		// still holds focus, which would drop focus to <body>; moving focus into
		// the input immediately after keeps the keyboard path intact. Closing
		// un-hides the launcher before focusing it — .focus() is a no-op on a
		// display:none element.
		const setOpen = (open: boolean, restoreFocus = true) => {
			modal.hidden = !open;
			root.toggleAttribute('data-open', open);
			toggleBtn.setAttribute('aria-expanded', String(open));
			if (open) input.focus();
			else if (restoreFocus) toggleBtn.focus();
		};

		// The launcher only opens now — it's hidden while the panel is up, and
		// the panel's own close button (and Esc) brings it back.
		toggleBtn.addEventListener('click', () => setOpen(!isOpen()));
		root.querySelector('[data-ns-close]')?.addEventListener('click', () => setOpen(false));
		root.querySelector('[data-ns-restart]')?.addEventListener('click', () => resetChat());

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && isOpen()) setOpen(false);
		});

		// Click outside the widget closes it, without stealing focus.
		document.addEventListener('click', (e) => {
			if (isOpen() && !root.contains(e.target as Node)) setOpen(false, false);
		});

		// Public entry point for in-page triggers — currently the landing page's
		// hero prompt panel (see src/components/Hero.astro):
		//
		//   document.dispatchEvent(
		//     new CustomEvent('ns-chat:ask', { detail: { question: '…' } })
		//   );
		//
		// Omit `question` to just open the panel.
		//
		// IMPORTANT: the caller must call stopPropagation() on the originating
		// click. Any trigger lives outside [data-ns-chat], so the outside-click
		// handler above fires later in the SAME bubbling click and would close
		// the panel again the instant this opens it.
		//
		// Registered inside initChat(), so the `data-ns-init` guard at the top
		// keeps it from being added twice across view transitions.
		document.addEventListener('ns-chat:ask', (e) => {
			const question = (e as CustomEvent).detail?.question?.trim();
			setOpen(true);
			if (!question) return;
			addMessage(question, 'user');
			sendMessage(question);
		});

		async function sendMessage(question: string) {
			const typing = renderMessage('Thinking…', 'bot', 'ns-chat__msg--typing');
			try {
				const res = await fetch(SEEK_URL, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', embedcode: EMBED_CODE },
					body: JSON.stringify({ question, sessionId, userId }),
				});
				// Auth/rate-limit failures come back as a plain-text body, not JSON.
				if (!res.ok) throw new Error(`Seek request failed (${res.status})`);
				const data = await res.json();
				typing.remove();
				addMessage(data.answer || "Sorry, I couldn't find an answer for that.", 'bot');
			} catch {
				typing.remove();
				addMessage('Something went wrong reaching NeuralSeek. Please try again in a moment.', 'bot');
			}
		}

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const q = input.value.trim();
			if (!q) return;
			addMessage(q, 'user');
			input.value = '';
			sendMessage(q);
		});
	}

	// Run on first load and on Starlight's client-side view transitions.
	initChat();
	document.addEventListener('astro:page-load', initChat);
</script>
