  "version": "0.0.1",
  "scripts": {
    "dev": "bun scripts/gen-graph.ts && astro dev",
    "start": "bun scripts/gen-graph.ts && astro dev",
    "build": "bun scripts/gen-graph.ts && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "stubs": "bun scripts/gen-stubs.ts",
    "check": "astro check",
