{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__neuralseek-ui__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pw-readonly.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__neuralseek-node__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/mcp-readonly.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-paths.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__neuralseek-ui__browser_(navigate|click|hover)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/nav-log.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
