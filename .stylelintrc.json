{
  "comment": "Deliberately tiny. stylelint-config-standard out of the box produces hundreds of errors here and argues with the design system on principle (sharp radii, descending specificity, per-theme token scales). This set targets only the classes of bug this stylesheet has actually had.",
  "rules": {
    "declaration-block-no-duplicate-properties": [
      true,
      { "ignore": ["consecutive-duplicates-with-different-values"] }
    ],
    "declaration-block-no-duplicate-custom-properties": true,
    "no-duplicate-selectors": true,
    "no-duplicate-at-import-rules": true,
    "custom-property-no-missing-var-function": true,
    "function-no-unknown": true,
    "no-invalid-position-at-import-rule": [true, { "ignoreAtRules": ["use"] }],
    "block-no-empty": true,
    "color-no-invalid-hex": true,
    "media-feature-name-no-unknown": true,
    "property-no-unknown": [true, { "ignoreProperties": ["/^--/"] }],
    "selector-pseudo-class-no-unknown": true,
    "selector-pseudo-element-no-unknown": true,
    "no-descending-specificity": null
  },
  "ignoreFiles": ["dist/**", ".astro/**", "node_modules/**"]
}
